; @rom <MD5 of a 16K bank> <bundled image> [-NAME / -@ADDR: not in that bank]
; ADDR NAME: a name; START END VIEW: a data range
@ns BASIC48
@rom a148bcc575e51389e84fdf5d555c3196 plus3-3.rom
@rom ef7bf942a1c1f9ed5d583d0a49e26db7 plus3-41.rom bank 3
3A29 HOOK_REPORT
3A34 HOOK_TO_010F
3A3B HOOK_STMT_JUMP
3A46 HOOK_TO_0112
3A4B HOOK_STMT_NEXT
3A55 HOOK_TO_0115
