; OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE
; SOFTWARE.
;
; Changed for Xpeccy+ on 2026-11-08: TAPE_KIND_MSGS and START_MESSAGES were one byte
; early, on the end of the text before them; moved to #09C1 and #1539, where the 48K
; list names them BLOCK_HDR and COPYRIGHT, so they are left out here.
;
; @rom <MD5 of a 16K bank> <bundled image> [-NAME / -@ADDR: not in that bank]
; ADDR NAME: a name; START END VIEW: a data range
@ns BASIC48
@rom ef7bf942a1c1f9ed5d583d0a49e26db7 plus3-41.rom bank 3
386E INT_KBD_MOTOR
387C INT_KBD_END
387F MOTOR_TIMEOUT
38AC MOTOR_TO_END
38B5 FILL_38B5
3A00 ROM_SWAP_3D03
3A05 ROM_SWAP_3D06
3A08 ROM_SWAP_HL
3A1B ROM_SWAP_BACK
3A29 HOOK_REPORT
3A34 HOOK_TO_010F
3A37 ROM0_JUMP
3A3B HOOK_STMT_JUMP
3A46 HOOK_TO_0112
3A4B HOOK_STMT_NEXT
3A55 HOOK_TO_0115
3A5A INKEY_KEYS
3A6E INKEY_NO_KEY
3A79 INKEY_NONE
3A7E OUT_NEW_TOKENS
3A86 OUT_TOKEN_OR_UDG
3A8E OUT_NEW_KEYWORD
3AA2 NEW_KEYWORD_OUT
3AA8 NEW_KEYWORD_END
3AB1 NEW_TOKEN_NAMES
3ABD JUMP_3C01
3AC0 FILL_3AC0
3BE1 UNUSED_ZEROS
3BFF FILL_3BFF
3C01 TEST_TEXT
3C09 FILL_3C09
3C97 UNUSED_TAIL
09A1 09F3 text
1391 1554 text
38B5 39FF db
3AB1 3ABC text
3AC0 3BE0 db
3BE1 3BFE db
3C01 3C08 db
3C09 3C96 db
3C97 3CFF db
