; ZX Spectrum 128K / +2 system variables at #5B00 for the Xpeccy+ debugger: the
; names and addresses of the ZX Spectrum +2 manual, chapter 8 part 25. Part of
; Xpeccy+, MIT license.
;
; @ram <bank>: names of RAM cells in that bank, at the CPU address it
; has at #4000-#7FFF
@ns BASIC128
@ram 5
5B00 SWAP
5B14 YOUNGER
5B1D ONERR
5B2F PIN
5B34 POUT
5B4A POUT2
5B58 TARGET
5B5A RETADDR
5B5C BANKM
5B5D RAMRST
5B5E RAMERR
5B5F BAUD
5B61 SERFL
5B63 COL
5B64 WIDTH
5B65 TVPARS
5B66 FLAGS3
5B67 N_STR1
5B71 HD_00
5B72 HD_0B
5B74 HD_0D
5B76 HD_0F
5B78 HD_11
5B7A SC_00
5B7B SC_0B
5B7D SC_0D
5B7F SC_0F
5B81 OLDSP
5B83 SFNEXT
5B85 SFSPACE
5B88 ROW01
5B89 ROW23
5B8A ROW45
5B8B SYNRET
5B8D LASTV
5B92 RNLINE
5B94 RNFIRST
5B96 RNSTEP
5B98 STRIP1
5BA0 STRIP2
