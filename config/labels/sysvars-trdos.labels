; TR-DOS 5.0x system variables for the Xpeccy+ debugger.
;
; Names and data ranges from "TR-DOS Disassembled" by Marcos Cruz
; (programandala.net), 2016-2017 (https://github.com/programandala-net/tr-dos, commit
; 3f58896b, 2023-10-31): trdos.symbols.input.z80s, inc/zx_spectrum_trdos_addresses.z80s,
; trdos.blocks.txt. Used with his permission (e-mail of 2026-11-08: "you can use the
; labels and any other material from my TR-DOS 5.03 dissassembly in any way you need").
;
;
; Changed for Xpeccy+ on 2026-11-08: names in capitals, a dot written as an
; underscore; the names of single bytes inside a variable (filename.1, .high) and
; of the fields of a disk sector in the buffer (trdos_sector_buffer) left out.
;
; @ram <bank>: names of RAM cells in that bank, at the CPU address it
; has at #4000-#7FFF; ADDR NAME [SIZE], the size where the next name is not its end
@ns TRDOS
@ram 5
5CB6 TRDOS_VARIABLE_INTERFACE_1_ZONE
5CC2 TRDOS_VARIABLE_0XC9
5CC3 TRDOS_VARIABLE_UNKNOWN_23747
5CC8 TRDOS_VARIABLE_DRIVE_A_MODE
5CC9 TRDOS_VARIABLE_DRIVE_B_MODE
5CCA TRDOS_VARIABLE_DRIVE_C_MODE
5CCB TRDOS_VARIABLE_DRIVE_D_MODE
5CCC TRDOS_VARIABLE_CAT_CURRENT_SECTOR
5CCD TRDOS_VARIABLE_DISK_DRIVE_READY
5CCE TRDOS_VARIABLE_SECTOR_RW_FLAG
5CCF TRDOS_VARIABLE_STACK_SP_COPY
5CD1 TRDOS_VARIABLE_BASIC_PROGRAM_AUTOSTART
5CD3 TRDOS_VARIABLE_UNKNOWN_23763
5CD4 TRDOS_VARIABLE_MOVE_COMMAND_DELETED_FILES
5CD5 TRDOS_VARIABLE_MOVE_COMMAND_FIRST_SECTOR
5CD6 TRDOS_VARIABLE_BAD_SECTORS_OR_MOVE_COMMAND_FIRST_TRACK
5CD7 TRDOS_VARIABLE_START_FILE_PARAMETER_OR_NUMBER_OF_TRACKS
5CD9 TRDOS_VARIABLE_CH_ADD
5CDB TRDOS_VARIABLE_STREAM_OR_FILE_SIZE
5CDD TRDOS_VARIABLE_FILENAME
5CE5 TRDOS_VARIABLE_FILE_TYPE
5CE6 TRDOS_VARIABLE_FILE_START
5CE8 TRDOS_VARIABLE_FILE_LENGTH_IN_BYTES
5CEA TRDOS_VARIABLE_FILE_LENGTH_IN_SECTORS
5CEB TRDOS_VARIABLE_FILE_FIRST_SECTOR
5CEC TRDOS_VARIABLE_FILE_FIRST_TRACK
5CED TRDOS_VARIABLE_C_FILE_START_OR_B_FILE_SIZE
5CEF TRDOS_VARIABLE_FILE_2_LENGTH_IN_BYTES
5CF1 TRDOS_VARIABLE_FILE_2_LENGTH_IN_SECTORS
5CF2 TRDOS_VARIABLE_FILE_2_FIRST_SECTOR
5CF3 TRDOS_VARIABLE_FILE_2_FIRST_TRACK
5CF4 TRDOS_VARIABLE_CURRENT_SECTOR
5CF5 TRDOS_VARIABLE_CURRENT_TRACK
5CF6 TRDOS_VARIABLE_CURRENT_TEMPORARY_DRIVE
5CF7 TRDOS_VARIABLE_CLEARED
5CF8 TRDOS_VARIABLE_TWO_FILES_DRIVE
5CF9 TRDOS_VARIABLE_CAT_DRIVE_OR_READ_VERIFY_FLAG
5CFA TRDOS_VARIABLE_DRIVE_A_STEP_RATE
5CFB TRDOS_VARIABLE_DRIVE_B_STEP_RATE
5CFC TRDOS_VARIABLE_DRIVE_C_STEP_RATE
5CFD TRDOS_VARIABLE_DRIVE_D_STEP_RATE
5CFE TRDOS_VARIABLE_LAST_FDC_COMMAND
5CFF TRDOS_VARIABLE_SECTOR
5D00 TRDOS_VARIABLE_BUFFER
5D02 TRDOS_VARIABLE_HL_COPY
5D04 TRDOS_VARIABLE_DE_COPY
5D06 TRDOS_VARIABLE_BYTES_COMPARED_BY_FIND_COMMAND
5D07 TRDOS_VARIABLE_DELETED_FILES
5D08 TRDOS_VARIABLE_FILENAME_FIRST_CHAR
5D09 TRDOS_VARIABLE_DATA_FILE_MODE
5D0C TRDOS_VARIABLE_BUFFER_FLAG
5D0D TRDOS_VARIABLE_FILE_NUMBER_FOR_COPYING
5D0E TRDOS_VARIABLE_COMMAND_MODE
5D0F TRDOS_VARIABLE_ERROR_CODE
5D10 TRDOS_VARIABLE_ERROR_CODE_MSB
5D11 TRDOS_VARIABLE_COMMAND_LINE_ADDRESS
5D13 TRDOS_VARIABLE_ERR_SP_COPY
5D15 TRDOS_VARIABLE_SHOW_SCREEN_FLAG
5D16 TRDOS_VARIABLE_SYSTEM_REGISTER
5D17 TRDOS_VARIABLE_SHOW_TITLE_FLAG
5D18 TRDOS_VARIABLE_INTERFACE_1_FLAG
5D19 TRDOS_VARIABLE_DEFAULT_DRIVE
5D1A TRDOS_VARIABLE_INTERNAL_ADDRESS_OF_FINISHING_PROC
5D1C TRDOS_VARIABLE_SP_COPY
5D1E TRDOS_VARIABLE_FIND_COMMAND_FOUND_FILE
5D1F TRDOS_VARIABLE_UNKNOWN_23839
5D20 TRDOS_VARIABLE_ENTERED_LINE_3_FIRST_CHARS
5D23 TRDOS_VARIABLE_MOVE_COMMAND_BLOCKS
5D25 TRDOS_VARIABLE_TMP_BUFFER_ADDRESS
5D26 TRDOS_VARIABLE_K_CHANNEL_OUTPUT
5D28 TRDOS_VARIABLE_K_CHANNEL_INPUT
5D2A TRDOS_VARIABLE_K_CHANNEL_ID
5D2B TRDOS_VARIABLE_S_CHANNEL_OUTPUT
5D2D TRDOS_VARIABLE_S_CHANNEL_INPUT
5D2F TRDOS_VARIABLE_S_CHANNEL_ID
5D30 TRDOS_VARIABLE_R_CHANNEL_OUTPUT
5D32 TRDOS_VARIABLE_R_CHANNEL_INPUT
5D34 TRDOS_VARIABLE_R_CHANNEL_ID
5D35 TRDOS_VARIABLE_P_CHANNEL_OUTPUT
5D37 TRDOS_VARIABLE_P_CHANNEL_INPUT
5D39 TRDOS_VARIABLE_P_CHANNEL_ID 1
