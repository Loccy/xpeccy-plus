; TR-DOS labels for the Xpeccy+ debugger.
;
; Names and data ranges from "TR-DOS Disassembled" by Marcos Cruz
; (programandala.net), 2016-2017 (https://github.com/programandala-net/tr-dos, commit
; 3f58896b, 2023-10-31): trdos.symbols.input.z80s, inc/zx_spectrum_trdos_addresses.z80s,
; trdos.blocks.txt. Used with his permission (e-mail of 2026-11-08: "you can use the
; labels and any other material from my TR-DOS 5.03 dissassembly in any way you need").
;
; Changed for Xpeccy+ on 2026-11-08: names in capitals, a dot written as an
; underscore (cli_command.cat as CLI_COMMAND_CAT), as the debugger takes them;
; cli_command.gosub renamed CLI_COMMAND_LOAD, the handler his own table gives the
; LOAD token; message.insert_destination_disk moved from #2725, inside an
; instruction, to #2785, where that text is; the message, token and title blocks
; shown as text.
;
; This list: TR-DOS 5.03 and the patched copies with its code at the same places.
;
; @rom <MD5 of a 16K bank> <bundled image> [-NAME / -@ADDR: not in that bank]
; ADDR NAME: a name; START END VIEW: a data range
@ns TRDOS
@rom 0c42e3b9ab8dd91ea096f1d0c07c55e5 phoenix.rom bank 1, profi-kramis02.rom bank 1
@rom ce0723f9bc02f4948c15d3b3230ae831 256s-3.rom -RST_18 -NOT_USED_0033 -NOT_USED_0805 -NOT_USED_16F9 -MAGIC_BUTTON_NMI_REQUEST -NOT_USED_31FD -NOT_USED_3FF0 -@0033 -@0805 -@31FD -@3FF0
@rom 26b2b42ffa5490275090c087b949a987 atm2.rom bank 1 -NOT_USED_0033 -NOT_USED_0805 -NOT_USED_16F9 -NOT_USED_31FD -NOT_USED_3FF0 -@0805 -@31FD -@3FF0
@rom b4c9634312b796063015450daef13dfa profi-bios10.rom bank 1, profi-bios20.rom bank 1, trdos504t.rom, tsconf.rom bank 1 -NOT_USED_0033 -NOT_USED_0805 -NOT_USED_16F9 -NOT_USED_31FD -NOT_USED_3FF0 -@0360 -@0805 -@31FD
@rom e522f5c4e2fd9c735f4a2a79f66c7c89 scorpion295.rom bank 3 -RST_18 -NOT_USED_0033 -NOT_USED_0805 -NOT_USED_16F9 -MAGIC_BUTTON_NMI_REQUEST -NOT_USED_31FD -NOT_USED_3FF0 -@0033 -@0805 -@16F9 -@31FD -@3FF0
@rom 0da70a5d2a0e733398e005b96b7e4ba6 trdos.rom -NOT_USED_0033 -NOT_USED_0805 -NOT_USED_16F9 -NOT_USED_31FD -TRY_B_AS_STEP_RATE_OF_TEMPORARY_DRIVE -NOT_USED_3FF0
@rom 7d8aa7d31bed0380faef83a75bfee7c9 zxevo-fe.rom bank 29 -RST_10 -RST_18 -RST_20 -NOT_USED_0033 -DO_INTERPRET_REM_COMMAND_IN_BASIC -TRDOS_TITLE -NOT_USED_0805 -MESSAGE_INTERFACE_1 -NOT_USED_16F9 -PRINT_NUMBER_IN_BC -WRITE_SECTORS -TABLE_C_COMMANDS -NOT_USED_31FD -PRINT_CHARACTER_A -TRY_B_AS_STEP_RATE_OF_TEMPORARY_DRIVE -NOT_USED_3FF0 -@0033 -@0360 -@0805 -@1000 -@288C -@288D -@288F -@2890 -@2892 -@2893 -@2895 -@2896 -@2898 -@2899 -@289B -@289C -@289E -@289F -@28A1 -@28A2 -@28A4 -@28A5 -@28A7 -@28A8 -@28AA -@28AB -@28AD -@28AE -@28B0 -@28B1 -@28B3 -@28B4 -@28B6 -@28B7 -@28B9 -@28BA -@28BC -@28BD -@28BF -@28C0 -@28C2 -@28C3 -@28C5 -@28C6 -@28C8 -@28C9 -@28CB -@28CC -@28CE -@28CF -@28D1 -@28D2 -@28D4 -@28D5 -@31FD -@3FF0
